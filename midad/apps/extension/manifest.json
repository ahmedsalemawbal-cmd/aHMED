{
  "manifest_version": 3,
  "name": "مِداد — سحب الجداول من نور ومدرستي",
  "short_name": "مِداد",
  "version": "1.0.0",
  "description": "يقرأ الجدول المعروض أمامك في نور أو مدرستي ويرسله إلى حسابك في مِداد لتنزّله إكسل أو وورد أو PDF.",
  "default_locale": "ar",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://noor.moe.gov.sa/*",
    "https://*.moe.gov.sa/*",
    "https://schools.madrasati.sa/*",
    "https://*.madrasati.sa/*"
  ],
  "action": {
    "default_title": "مِداد — اسحب الجدول",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.moe.gov.sa/*",
        "https://*.madrasati.sa/*"
      ],
      "js": [
        "src/core.js",
        "src/panel.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
