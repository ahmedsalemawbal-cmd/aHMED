{
  "manifest_version": 3,
  "name": "مِداد — جداول نور",
  "short_name": "مِداد",
  "version": "1.0.0",
  "description": "أرسل جداول منصّة نور إلى حسابك في مِداد بضغطة واحدة. لا تعمل إلّا حين تضغطها بنفسك.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "مِداد — أرسل الجدول",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://ehimyixcqnmnwgbqrdmr.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}